# Kopiere diese Datei zu ".env" und trage deine Schluessel ein.
# Du brauchst nur den Schluessel fuer das Gehirn, das du nutzt (siehe
# [provider] aktiv in config/settings.toml).

# Fuer Claude (Anthropic): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Fuer DeepSeek (sehr guenstig): https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Optional: Modell des aktiven Providers erzwingen
# KI_MODEL=deepseek-chat

# Optional: Bilder malen ueber dein eigenes kostenloses Cloudflare-Konto (schneller als
# AI Horde, das ohne Anmeldung laeuft). Am einfachsten in der App unter
# "Gehirn & Schluessel" -> "Bilder (optional)" eintragen - oder hier die # entfernen:
# CLOUDFLARE_AI_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
